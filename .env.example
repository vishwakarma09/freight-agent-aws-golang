# Copy to .env (dev) or .env.production (gitignored) and populate real values.
# On AWS Lambda, store these keys as a JSON object in AWS Secrets Manager:
#   Secret Name: freight-agent/prod/secrets
#   Sync helper: ./scripts/sync_secrets_to_aws.sh prod us-east-2

ENV=prod
FRONTEND_URL=https://freight.owera.ca
ALLOWED_ORIGINS=https://freight.owera.ca
S3_BUCKET_NAME=freight-private-prod-ACCOUNT_ID
ACM_CERTIFICATE_ARN=arn:aws:acm:us-east-1:ACCOUNT_ID:certificate/REPLACE_ME

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/freight_bidding_db?sslmode=require

# Cryptographic Secrets (generate with: openssl rand -hex 32)
JWT_SECRET=REPLACE_WITH_64_HEX_CHAR_RANDOM_SECRET
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHAR_RANDOM_AES256_KEY
KMS_KEY_ID=

# AI Extraction
CEREBRAS_API_KEY=REPLACE_ME

# Google OAuth SSO
GOOGLE_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE_ME

# Platform System SMTP (Auth activation, password reset, org invites)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@owera.ca
SMTP_PASSWORD=REPLACE_ME
EMAILS_FROM_EMAIL=noreply@owera.ca
SMTP_TLS=true

# Stripe Option A Monetization
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_PRICE_BOUTIQUE_MONTHLY=price_REPLACE_ME
STRIPE_PRICE_BOUTIQUE_ANNUAL=price_REPLACE_ME
STRIPE_PRICE_GROWTH_MONTHLY=price_REPLACE_ME
STRIPE_PRICE_GROWTH_ANNUAL=price_REPLACE_ME
STRIPE_PRICE_ENTERPRISE_MONTHLY=price_REPLACE_ME
STRIPE_PRICE_ENTERPRISE_ANNUAL=price_REPLACE_ME
STRIPE_METER_EVENT_NAME=freight_quote_overage
